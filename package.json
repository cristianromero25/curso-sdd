{
  "name": "tareas-app",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Gestor de tareas: proyecto de práctica del curso «SDD en la práctica»",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "spec:validate": "openspec validate --all --strict && tsx scripts/comprobar-config.ts",
    "trazabilidad": "tsx scripts/trazabilidad.ts",
    "check": "npm run typecheck && npm test && npm run trazabilidad && npm run spec:validate"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "express": "^5.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^2.1.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
