# better-sqlite3 trae binarios precompilados y declara "gypfile": false, pero incluye un binding.gyp
# y npm 10 ejecuta igualmente `node-gyp rebuild` al instalarlo: sin Visual Studio Build Tools, falla.
# npm 10 no permite desactivar los scripts de un solo paquete; ninguna otra dependencia los necesita.
ignore-scripts=true
